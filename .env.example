POSTGRES_DB=circular
POSTGRES_USER=circular
POSTGRES_PASSWORD=circular
POSTGRES_PORT=5432
DATABASE_URL=postgresql://circular:circular@localhost:5432/circular
CIRCULAR_POLL_INTERVAL_SECONDS=1
CIRCULAR_FAKE_DELAY_SECONDS=0.05
CIRCULAR_REPOSITORY_CACHE_ROOT=.circular/repositories
CIRCULAR_WORKTREE_ROOT=.circular/worktrees
CIRCULAR_REVIEW_CONTEXT_ROOT=.circular/review-contexts
# Set CIRCULAR_DOCKER_REVIEW_CONTEXT_ROOT only when the Docker daemon sees a different host path.
CIRCULAR_ARTIFACT_ROOT=.circular/artifacts
CIRCULAR_RUNNER_IMAGE=circular-runner:dev
CIRCULAR_RUNNER_CPU_LIMIT=1
CIRCULAR_RUNNER_MEMORY_LIMIT_MB=2048
# Optional real backend. Build infra/codex-agent-workload.Dockerfile first.
CIRCULAR_CODEX_ENABLED=false
CIRCULAR_CODEX_IMAGE=circular-codex-runner:dev
CIRCULAR_CODEX_AUTH_MODE=chatgpt
CIRCULAR_CODEX_AUTH_ROOT=.circular/codex-auth
# Sign in with: go run ./cmd/circular-codex-auth login
# Optional API billing instead: explicitly set CIRCULAR_CODEX_AUTH_MODE=api_key
# and CIRCULAR_CODEX_API_KEY in the worker environment, never in Agent config.
# A different Docker host path can be set with CIRCULAR_DOCKER_CODEX_AUTH_ROOT.
# Compose resolves this to $PWD/.circular by default. Override it with an absolute
# host path when Compose is launched through tooling with a different working directory.
# CIRCULAR_EXECUTION_HOST_ROOT=/absolute/path/to/circular/.circular
VITE_API_URL=http://localhost:8000

# Optional project integrations. See docs/development/integrations.md.
CIRCULAR_PUBLIC_API_URL=http://localhost:8000
CIRCULAR_API_BIND_HOST=127.0.0.1
CIRCULAR_WEB_URL=http://localhost:5173
# Generate once with openssl rand -base64 32; retain the same key across restarts.
CIRCULAR_INTEGRATIONS_ENCRYPTION_KEY=
# Leave provider settings empty to register apps from Setup → Integrations.
# Optional existing GitHub App (Client ID, not App ID). For draft PR delivery:
# Repository Contents and Pull requests: read and write.
CIRCULAR_GITHUB_CLIENT_ID=
CIRCULAR_GITHUB_CLIENT_SECRET=
CIRCULAR_GITHUB_APP_SLUG=
# Optional environment-managed signing key, read by trusted API/worker only.
# With Compose, put it in .circular/secrets/github-app.pem and set this to
# /var/lib/circular/secrets/github-app.pem. Console setup encrypts uploaded keys.
CIRCULAR_GITHUB_PRIVATE_KEY_FILE=
# Optional existing Linear OAuth application. PKCE uses the public Client ID.
CIRCULAR_LINEAR_CLIENT_ID=
# Optional; not required for console setup or PKCE authorization and refresh.
CIRCULAR_LINEAR_CLIENT_SECRET=

# Provider webhook ingress uses the separate receiver at 127.0.0.1:8001.
# Configure its public HTTPS origin in Integrations; never expose the control API.
